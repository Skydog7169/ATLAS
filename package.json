{
  "name": "atlas",
  "private": true,
  "version": "0.2.0",
  "description": "ATLAS \u2014 an interactive geopolitics map: power blocs and active conflicts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-feeds.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:countries": "node scripts/build-countries.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "data:research": "node scripts/research/update.mjs",
    "data:research:mock": "node scripts/research/update.mjs --mock --dry-run",
    "data:displacement": "node scripts/build-displacement.mjs",
    "data:worldbank": "node scripts/build-worldbank.mjs",
    "feeds": "node scripts/build-feeds.mjs",
    "data:sanctions": "node scripts/build-sanctions.mjs",
    "data:elections": "node scripts/build-elections.mjs",
    "data:acled": "node scripts/build-acled.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
