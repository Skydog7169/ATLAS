    { "iso": "BEL", "status": "hosting", "note": "NATO nuclear sharing: hosts US B61 bombs at Kleine Brogel.", "sources": [{ "name": "NATO: nuclear deterrence", "url": "https://www.nato.int/cps/en/natohq/topics_50068.htm" }] },
    { "iso": "DEU", "status": "hosting", "note": "NATO nuclear sharing: hosts US B61 bombs at Büchel.", "sources": [{ "name": "NATO: nuclear deterrence", "url": "https://www.nato.int/cps/en/natohq/topics_50068.htm" }] },
    { "iso": "ITA", "status": "hosting", "note": "NATO nuclear sharing: hosts US B61 bombs at Aviano and Ghedi.", "sources": [{ "name": "NATO: nuclear deterrence", "url": "https://www.nato.int/cps/en/natohq/topics_50068.htm" }] },
