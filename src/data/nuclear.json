    { "iso": "USA", "status": "armed", "note": "About 3,700 stockpiled warheads (SIPRI, Jan 2026). Testing moratorium since 1992; an October 2025 presidential instruction to resume testing had produced no explosive test by October 2026.", "sources": [{ "name": "CRS: U.S. nuclear weapons tests", "url": "https://www.congress.gov/crs_external_products/IF/HTML/IF11662.html" }, { "name": "Sen. Rosen on NNSA testimony, April 2026", "url": "https://www.rosen.senate.gov/2026/04/13/as-trump-administration-weighs-resuming-explosive-nuclear-testing-rosen-visits-the-nevada-national-security-site-to-observe-nuclear-stockpile-certification/" }] },
    { "iso": "RUS", "status": "armed", "note": "Largest inventory; about 4,300 stockpiled warheads (SIPRI, Jan 2026). Tactical weapons forward-deployed to Belarus since 2023.", "sources": [{ "name": "SIPRI Yearbook 2026", "url": "https://www.sipri.org/media/press-release/2026/increasing-focus-nuclear-weapons-amid-heightened-escalation-risks-new-sipri-yearbook-out-now" }] },
    { "iso": "CHN", "status": "armed", "note": "Fastest-growing arsenal, about 620 warheads (SIPRI, Jan 2026).", "sources": [{ "name": "SIPRI Yearbook 2026", "url": "https://www.sipri.org/media/press-release/2026/increasing-focus-nuclear-weapons-amid-heightened-escalation-risks-new-sipri-yearbook-out-now" }] },
    { "iso": "FRA", "status": "armed", "note": "About 290 warheads; independent sea- and air-launched deterrent.", "sources": [{ "name": "Arms Control Association", "url": "https://www.armscontrol.org/factsheets/nuclear-weapons-who-has-what-glance" }] },
    { "iso": "GBR", "status": "armed", "note": "About 225 warheads; submarine-based Trident force, ceiling raised to 260 in 2021.", "sources": [{ "name": "Arms Control Association", "url": "https://www.armscontrol.org/factsheets/nuclear-weapons-who-has-what-glance" }] },
    { "iso": "IND", "status": "armed", "note": "About 190 warheads (SIPRI, Jan 2026); outside the NPT. Last tests 1998.", "sources": [{ "name": "SIPRI Yearbook 2026", "url": "https://www.sipri.org/media/press-release/2026/increasing-focus-nuclear-weapons-amid-heightened-escalation-risks-new-sipri-yearbook-out-now" }] },
    { "iso": "PAK", "status": "armed", "note": "About 170 warheads (SIPRI, Jan 2026); outside the NPT. Last tests 1998.", "sources": [{ "name": "SIPRI Yearbook 2026", "url": "https://www.sipri.org/media/press-release/2026/increasing-focus-nuclear-weapons-amid-heightened-escalation-risks-new-sipri-yearbook-out-now" }] },
    { "iso": "PRK", "status": "armed", "note": "Six tests, the last on 3 September 2017; the Punggye-ri site has been assessed ready for a seventh since 2020.", "sources": [{ "name": "CRS: North Korea's nuclear weapons", "url": "https://www.congress.gov/crs_external_products/IF/HTML/IF10472.web.html" }, { "name": "CSIS Beyond Parallel: Punggye-ri", "url": "https://beyondparallel.csis.org/recent-activity-observed-at-punggye-ri-nuclear-test-facility/" }] },
    { "iso": "ISR", "status": "armed", "note": "Undeclared arsenal, estimated around 90 warheads; outside the NPT.", "sources": [{ "name": "Arms Control Association", "url": "https://www.armscontrol.org/factsheets/nuclear-weapons-who-has-what-glance" }] },
    { "iso": "IRN", "status": "threshold", "note": "NPT party. Enriched to 60% before the June 2025 strikes; roughly 440 kg of 60% material unaccounted for, enrichment halted and almost no IAEA inspections for over six months by October 2026. Withdrawal from the NPT threatened, not enacted.", "sources": [{ "name": "FDD, March 2026", "url": "https://www.fdd.org/analysis/2026/03/30/iran-revives-threat-to-withdraw-from-nuclear-non-proliferation-treaty/" }, { "name": "Al Jazeera, 7 October 2026", "url": "https://www.aljazeera.com/news/2026/10/7/us-sets-new-demands-for-iran-deal-what-are-they" }] },
