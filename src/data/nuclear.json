    { "iso": "AUS", "status": "umbrella", "note": "US extended deterrence under ANZUS; nuclear-powered, conventionally armed submarines under AUKUS.", "sources": [{ "name": "Arms Control Association", "url": "https://www.armscontrol.org/factsheets/nuclear-weapons-who-has-what-glance" }] }
