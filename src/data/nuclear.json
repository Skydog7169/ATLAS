    { "iso": "TUR", "status": "hosting", "note": "NATO nuclear sharing: hosts US B61 bombs at Incirlik.", "sources": [{ "name": "NATO: nuclear deterrence", "url": "https://www.nato.int/cps/en/natohq/topics_50068.htm" }] },
    { "iso": "JPN", "status": "umbrella", "note": "US extended deterrence; latent capability through a large civil fuel cycle.", "sources": [{ "name": "Arms Control Association", "url": "https://www.armscontrol.org/factsheets/nuclear-weapons-who-has-what-glance" }] },
